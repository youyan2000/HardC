# HardC 项目 .clang-tidy

# 用法: clang-tidy <file> -- -I BSP -I Components -I Devices -I Module

Checks: >
  -*,
  bugprone-*,
  cert-*,
  performance-*,
  readability-identifier-naming,
  -bugprone-easily-swappable-parameters,
  -cert-err33-c,
  -cert-msc30-c,
  -cert-msc32-c,
  -performance-no-int-to-ptr,
  -bugprone-reserved-identifier,

CheckOptions:
  # 类型: PascalCase (LedBase, AdcOps, PwmBuckBoost)
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase

  # 函数: snake_case (led_on, adc_read_ch, pid_compute)
  - key: readability-identifier-naming.FunctionCase
    value: lower_case

  # 变量: snake_case (on_level, raw_cap)
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  # 全局常量/枚举值/宏: UPPER_CASE
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  # 类成员 (C 结构体字段): snake_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
