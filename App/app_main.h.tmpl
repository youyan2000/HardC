// ======== 2. 项目配置结构体 (YAML 注入目标) ========
// 这是 PURE DATA — 不包含运行时状态。YmaC 工具在 /* CONFIG BEGIN/END */ 之间注入。

// 示例: PID 参数组
typedef struct {
  float kp, ki, kd, kf;
  float out_limit;  // 输出限幅 (PWM 占空比最大值)
  bool d_on_measurement;
  float i_limit;
} PidCfg;

// 示例: 电机参数组
typedef struct {
  PidCfg vel;        // 速度环
  PidCfg pos;        // 位置环
  float csc_vlimit;  // 级联 PID 内环限幅 (vlimit=20 刚好, LESSONS.md #13)
} MotorCfg;

// --- Power-OOP: 电源配置类型 (CFGSTRUCT 锚点 — 由生成器按拓扑重定义) ---
// PowerCfg = 拓扑主控制模块 (control_module) 的 cfg 类型:
//   Buck (默认):          typedef ModBuckCfg PowerCfg;
//   supercap_3ph:         typedef ModSuperCapCfg PowerCfg;  (gen_app 替换锚点内容)
// ProjectConfig 内 .power 字段类型跟随此 typedef.
/* YMAC CFGSTRUCT BEGIN */
typedef ModBuckCfg PowerCfg;
/* YMAC CFGSTRUCT END */

// 项目总配置 — 聚合所有子系统的可调参数
typedef struct {
  MotorCfg mot_a;
  MotorCfg mot_b;
  // FollowerCfg follower;    // 循迹参数 (按需)
  PowerCfg power;     // 电源: 主控制模块配置 (类型 = CFGSTRUCT 锚点定义)
  ModShareCfg share;  // 均流配置 (supercap_3ph 拓扑使用; Buck 默认未用, 零初始化无副作用)
  // AdcCfg     adc;           // ADC 采样参数 (按需)
  // StepMotorCfg step;         // 步进电机参数 (按需)
  // BalCfg     bal;            // 球板平衡参数 (按需)
} ProjectConfig;

// 全局配置实例 — YmaC 注入到此变量的 CONFIG BEGIN/END 之间
extern ProjectConfig g_cfg;

// ======== 3. 根结构体 (App 拥有所有实例) ========
//
// 设计原则:
//   - 所有 Device 和 Module 实例嵌入此结构体 (值包含, 无 malloc)
//   - Module 之间通过指针引用 (board_init 中一次性解析)
//   - 指针图是封闭的: 所有指针指向此结构体内的其他成员
//   - "extern ProjectRoot root" 让 Module 可直接访问兄弟模块

typedef struct {
  // --- Device 实例 (值包含) ---
  // Uart       drv_uart;         // USART1 调试串口
  // Gpio       drv_key1;         // 按键1 (GPIO 输入, 去抖在 HMI)
  // PidStandard drv_vel_a;       // 电机A 速度环
  // PidStandard drv_pos_a;       // 电机A 位置环
  // PidCascade drv_csc_a;        // 电机A 级联
  // PidP2PD   drv_fpid;          // 循迹 P2PD
  // MotTim    drv_mtr_a;         // 电机A 驱动
  // PerMpu6050 drv_mpu;          // 陀螺仪 (peripheral 域)
  // AdcFollower drv_follower;    // 红外循迹

  // --- Module 实例 (值包含) ---
  // MotApp    mtr_a;             // 电机A 状态机 (mod_motor.h)
  // MotApp    mtr_b;             // 电机B 状态机
  // Follower  flw;               // 循迹状态机 (mod_follower.h)
  // TurnCtrl  turn;              // 转弯状态机 (mod_turn.h)
  // Hmi       hmi;               // 人机交互 (mod_hmi.h)
  //   // 输出端口路由 (board_init 绑定): hmi_port_bind(&hmi.out.can, &can_proto, cb_can);
  //   //                             hmi_port_bind(&hmi.out.uart, &serial_proto, cb_uart);
  //   //                             hmi_port_bind(&hmi.out.led, &g_led_board, cb_led);
  //   // 端口回调在 hmi_tick (控制 ISR/CTX_FAST) 执行, 必须非阻塞 — 只入队/置标志, 真实 I/O 由 BackgroundTask
  // ModBalance bal;              // 球板平衡 (mod_balance.h, 按需)
  // StepMotor step_x;            // X轴步进电机 (motor_step.h, 按需)
  // StepMotor step_y;            // Y轴步进电机 (motor_step.h, 按需)

  // --- Module 实例 (通用, 每个项目都需要) ---
  ModComm mod_comm;            // 帧协议解析
  CmdDispatcher cmd_dispatch;  // 命令分发器
  SerialProto serial_proto;    // 串口协议
  ModCanProto can_proto;       // CAN 协议 (HMI 输出端口, 按需)

  /* YMAC ROOT BEGIN */
  // ==== 由 ymac_cfg 生成: 电源域根成员 (默认 = Buck 参考; supercap_3ph 替换为 share/supercap/drv_can) ====
  // --- Power-OOP: 电力电子设备 (Buck 演示) ---
  PwmBuckBoost drv_buck_pwm;  // Buck 降压 PWM 设备 (pwm_buckboost.h)
  AdcDcSampler drv_dc_adc;    // 直流采样器 (adc_dc_sampler.h, vout/iout/vin)

  // --- Power-OOP: 电源控制 Module (PowerStage 集成模式示例) ---
  ModBuck buck;  // Buck 降压控制 (mod_buck.h)
  /* YMAC ROOT END */

  // --- 诊断 ---
  Heartbeat heartbeat;      // 心跳看门狗 (comp_protection.h): FAST 内 Heartbeat_Tick, SLOW 内 Heartbeat_Check
  uint32_t idle_cnt;        // 主循环空闲计数 (负载率指标)

} ProjectRoot;

// 全局根实例 — Module 可通过 extern 访问
extern ProjectRoot g_root;

// ======== 4. API ========

// 板级初始化 — 在 CubeMX MX_*_Init() 之后, while(1) 之前调用
// 完成: Device 实例化 → Module 实例化 → 指针注入 → ISR 启动
void board_init(void);

// 配置同步 — 将 g_cfg 的参数复制到运行时实例
// 调用时机: (1) 启动时 (2) YAML 重新注入后 (3) 串口 0xFB 调参后
void apply_config(void);

// 主循环后台任务 — 在 while(1) 中调用
// 完成: 软件I2C、printf调试输出、OLED刷新、串口应答
void BackgroundTask(void);

// ======== 5. ISR 钩子 (在 stm32f1xx_it.c 的回调中调用) ========

// HAL_TIM_PeriodElapsedCallback — 控制定时器 ISR (如 TIM3, 10ms/100Hz)
// 调用顺序: ADC采样 → 传感器 → HMI/命令 → 控制算法 → 电机输出
void App_OnControlTick(void);

// 监控定时器 ISR — CTX_SLOW (软实时): 慢保护去抖 / 状态聚合 / 心跳喂狗 / 软关断判决
// 与 App_OnControlTick 分离: FAST 只做确定的事; SLOW 允许轻微抖动, 但确认问题即关断
// 由独立监控定时器驱动 (如 1ms/1kHz), 或在 FAST ISR 末尾降频调用
void App_OnSlowTick(void);

// HAL_UART_RxCpltCallback — 串口接收完成
void App_OnUartRx(uint8_t byte);

// HAL_GPIO_EXTI_Callback — GPIO 外部中断 (编码器/按键/MPU6050 INT)
void App_OnGpioExti(uint16_t pin);

#endif  // APP_MAIN_H
