// ======== 3. 板级初始化 ========
// 在 CubeMX MX_*_Init() 之后, 主循环之前调用
// 这是唯一创建和绑定实例的地方 — 所有指针在此解析, 此后不变

void board_init(void) {
  // --- 3a. Device 实例化 (每个子类调自己的 _init) ---
  // 电机/循迹/步进等示例见 app_main.h.tmpl 注释 (本模板聚焦电力电子 Buck).
  // 通用模式: <dev>_init(&g_root.drv_xxx, <句柄/引脚>...) 绑定底层资源.

  // --- 3b. Module 实例化 (指针注入: 绑定 Devices 到 Modules) ---
  // 每个 Module init 接收它需要的 Base* 指针, 存入 Module 内部.
  // 例: motapp_init(&g_root.mtr_a, &g_root.drv_mtr_a.base, &g_root.drv_vel_a.base, NULL, NULL);

  // --- 3b2. Power-OOP: 电源控制 (PowerStage 集成模块示例: Buck 降压) ---

  // 设备实例化 — 由 ymac_cfg 生成器注入 (拓扑 + .ioc/.syscfg 外设绑定):
  //   pwm_bb_init(&g_root.drv_buck_pwm, 100000u, BSP_TIMER_A, BSP_OUT_TIMER_A_PAIR,
  //               PwmMode_Buck, /*sync_rect=*/true);
  //   g_root.drv_buck_pwm.bsp_cfg.handle = &hhrtim1;
  //   g_root.drv_buck_pwm.bsp_cfg.clk_hz = 72000000u;
  //   adc_dc_sampler_init(&g_root.drv_dc_adc, IO_ASYNC_FLAG, &hadc1, &hdma_adc1, 3,
  //                       (float[]){0.0072f, 0.05f, 0.0072f}, NULL, NULL);
  /* YMAC BSP BEGIN */
  // === 此处由 ymac_cfg 注入 BSP/外设绑定 (HRTIM + ADC + 通道注释) ===
  /* YMAC BSP END */

  // ModBuck 实例化: 绑定 ops + 存 cfg (来自 g_cfg.power) + 初始化双环 PI
  // (init 内部已 sync_cfg 派生 PI 限幅; 末尾 apply_config() 会再同步一次)
  mod_buck_init(&g_root.buck, &g_cfg.power);
  // 指针注入: ModBuck 具体设备 + PowerStage 基类 pwm/adc (base 首成员下溯)
  mod_buck_bind(&g_root.buck, &g_root.drv_buck_pwm, &g_root.drv_dc_adc);

  // 0xFB 串口调参: 槽位 0-9 → g_cfg.power → apply_config (见文件末尾)
  pid_tune_set_apply_cb(on_pid_tune_received);

  // --- 3c. 通用 Module (每个项目都需要) ---

  // 命令分发器 (注册各子系统的命令处理函数)
  cmd_dispatch_init(&g_root.cmd_dispatch);
  // cmd_dispatch_register(&g_root.cmd_dispatch, CMD_SYS_START, sys_start_handler);

  // 串口协议 (ISR 喂入 → 主循环处理)
  serial_proto_init(&g_root.serial_proto);
  // serial_proto.on_pid_tune = on_pid_tune_received;

  // --- 3d. 启动硬件 ---
  // HAL_TIM_Base_Start_IT(&htim3);        // 控制定时器 (如 100Hz)
  // comm_bgn(&g_root.drv_uart.base);      // UART 接收 (若接了调试串口)

  // --- 3e. 初始配置加载 ---
  Heartbeat_Init(&g_root.heartbeat);  // 心跳看门狗清零 (全局零初始化本可, 模板显式化以防非零态根结构体)
  apply_config();
}

// ======== 4. ISR 钩子 ========

