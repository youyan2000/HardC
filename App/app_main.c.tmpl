// ======== 6. 串口 0xFB PID 调参回调 ========
//
// 收到合法调参帧后由 pid_tune_respond() 在主循环中回调 (非 ISR).
// 槽位映射 (与 Config/topologies/buck.yaml params.slot 完全一致):
//   [0]=vref  [1]=iref  [2]=pid_v.kp  [3]=pid_v.ki
//   [4]=pid_i.kp  [5]=pid_i.ki  [6]=ff_weight
//   [7]=ovp  [8]=ocp  [9]=soft_start_step

static void on_pid_tune_received(const float coef[10]) {
  // 槽位 0-9 → g_cfg.power (同步回配置, 下次 YAML 注入保持一致)
  g_cfg.power.vref = coef[0];
  g_cfg.power.iref = coef[1];
  g_cfg.power.pid_v.kp = coef[2];
  g_cfg.power.pid_v.ki = coef[3];
  g_cfg.power.pid_i.kp = coef[4];
  g_cfg.power.pid_i.ki = coef[5];
  g_cfg.power.ff_weight = coef[6];
  g_cfg.power.ovp = coef[7];
  g_cfg.power.ocp = coef[8];
  g_cfg.power.soft_start_step = coef[9];

  // 同步到运行时实例 (整体拷贝 + PI 限幅派生)
  apply_config();
}
