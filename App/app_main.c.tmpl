  // --- PID 调参应答 (printf, 不能放 ISR) ---
  // pid_tune_respond();

  // --- 传感器查询应答 ---
  // sensor_query_send();

  // --- OLED 刷新 (软件 SPI, 阻塞操作) ---
  // oled_flush();

  // --- 事件日志输出 ---
  // DeferredAction_Poll(&g_root.deferred, DEFER_LOG_SENSOR) → printf
