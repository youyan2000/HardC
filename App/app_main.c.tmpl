// 调用时机: 启动 / YAML注入后 / 0xFB串口调参后

void apply_config(void) {
  // 示例: 电机A 速度环
  // pid_std_set_kp(&g_root.drv_vel_a, g_cfg.mot_a.vel.kp);
  // pid_std_set_ki(&g_root.drv_vel_a, g_cfg.mot_a.vel.ki);
