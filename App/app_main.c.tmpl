// ======== 4. ISR 钩子 ========

// 控制定时器 ISR — 所有控制算法和状态机的驱动源
// 调用顺序很重要: 先传感器 → 再决策 → 最后执行器
void App_OnControlTick(void) {
  g_root.heartbeat++;   // ISR 心跳 (供 Heartbeat 看门狗检测死锁)

  // === 第1层: 传感器采样 ===
  // ADC 数据处理 (红外循迹 + 电压/电流)
  // adc_process(&g_root.drv_follower.base);
  // 陀螺仪角速度积分 (仅用于显示和盲跑, LESSONS #1)
  // mpu6050_yaw_integrate(&g_root.drv_mpu);

  // === 第2层: HMI + 命令分发 ===
  // 按键扫描 + 去抖 + 按键→CarCmd→dispatch
  // hmi_tick(&g_root.hmi);

  // === 第3层: 控制算法 (状态机 tick) ===
  // 电机 tick: 读编码器 → PID 计算 → 写 PWM
  // motapp_tick(&g_root.mtr_a);
  // motapp_tick(&g_root.mtr_b);
  // 转弯控制 (可能覆盖电机的速度目标)
  // turnctrl_tick(&g_root.turn);
  // 循迹控制 (P2PD 差速修正, 覆盖电机速度目标)
  // follower_tick(&g_root.flw);
  // 步进电机脉冲 ISR (由定时器中断独立驱动, 不在此处)
  // 球板平衡 (在主循环中由摄像头帧驱动, 不在此处)

  // === 第4层: 执行器输出 ===
  // PWM 输出已在 motapp_tick 内部写入, 此处无需额外操作

  // === 第5层: 延迟标记 (ISR 中不执行, 标记后由 BackgroundTask 处理) ===
  // if (需要打印传感器数据)  DeferredAction_Set(&g_root.deferred, DEFER_LOG_SENSOR);
  // if (需要发送串口应答)    DeferredAction_Set(&g_root.deferred, DEFER_SEND_UART);
}

