// FAST 每控制周期 adc_dc_sampler_fetch(&g_root.drv_dc_adc) 消费快照 (fetch/process 分离, 撕裂读消除).

// 控制定时器 ISR — 所有控制算法和状态机的驱动源
// 调用顺序很重要: 先传感器 → 再决策 → 最后执行器
void App_OnControlTick(void) {
  Heartbeat_Tick(&g_root.heartbeat);  // 快通道心跳 (SLOW 判死锁 → 停止喂狗 → IWDG 复位)

  // === 第1层: 传感器采样 ===
  // adc_dc_sampler_fetch(&g_root.drv_dc_adc);  // PingPong 切快照 + 只碰活动块 (DMA 完成 ISR 已标 pending)

  // === 第2层: HMI + 命令分发 ===
  // hmi_tick(&g_root.hmi);

  // === 第3层: 控制算法 (状态机 tick) ===
  // 电源控制: Buck 降压 (采样→双环→PWM, 内部状态机, 未 start 时为空转)
  mod_buck_tick(&g_root.buck);
  // 电机 tick (按需): motapp_tick(&g_root.mtr_a);  follower_tick(&g_root.flw);

  // === 第4层: 执行器输出 ===
  // PWM 输出已在 mod_buck_tick 内部写入, 此处无需额外操作

  // === 第5层: 延迟标记 (ISR 中不执行, 标记后由 BackgroundTask 处理) ===
  // if (需要打印传感器数据)  DeferredAction_Set(&g_root.deferred, DEFER_LOG_SENSOR);
}

