// Bootloader 独立 App — 实现模板 (bootloader_main.c)
//
// Bootloader 极简固件入口:
//   bootloader_board_init(): 绑定升级传输 + Flash + Database → 初始化 boot_loader
//   bootloader_background(): 升级协议主循环 (boot_loader_poll)
//
// 启动流程:
//   1. main() 调 bootloader_board_init()
//   2. init 内部:
//      - 读 Database 升级标志
//      - 有升级请求 → 进入升级模式 (boot_loader_poll 接管)
//      - 无升级请求 → 校验 App 有效 → bsp_jump_to_app 跳转
//   3. 升级模式: bootloader_background() 循环调 boot_loader_poll
//
// 注: Bootloader 不开控制环 (无 CTX_FAST), 只跑通信 + Flash 写.
//   202508 阶段 4: 最小闭环骨架, 由 YmaC 按 bootloader 拓扑生成具体接线.

#include "bootloader_main.h"

#include "bsp_flash.h"
#include "bsp_jump.h"
#include "bsp_uart.h"
#include "bsp_can.h"
#include "com_uart.h"
#include "com_can.h"
#include "boot_loader.h"
#include <string.h>

// ======== 全局根实例 ========
BootloaderRoot g_boot_root;

// ======== 升级传输 (UART/CAN 二选一, 由 YmaC 注入) ========
// 这里给 UART + CAN 两个蓝图, 由一个启用 (按 bootloader 拓扑 YAML)

// UART 传输适配: com_uart 的 RX 完成 → boot_loader_rx
//   (实际: UART RX 中断 → uart_rx_event → 从 rxq 读 → boot_loader_rx)
static Uart s_up_uart;
static int up_rx_push(void *ctx, const uint8_t *data, uint16_t len) {
  (void) ctx;
  return boot_loader_rx(&g_boot_root.bootloader, data, len);
}
static int up_tx_report(void *ctx, const uint8_t *data, uint16_t len) {
  (void) ctx;
  (void) data;
  (void) len;
  return 0;  // 应答发送 (可接 uart_write)
}

// CAN 传输适配: com_can 订阅升级 ID → boot_loader_rx
static int up_can_rx_push(void *ctx, const uint8_t *data, uint16_t len) {
  (void) ctx;
  return boot_loader_rx(&g_boot_root.bootloader, data, len);
}

// ======== Flash + Database 绑定 ========
// Bootloader 管理的 Flash 区域 = App 区 (从 app_addr 起)
//   (bsp_flash_set_region 后, boot_loader 通过 bsp_flash_* 写 App 区)

// ======== 板级初始化 ========

void bootloader_board_init(void) {
  // --- 1. 绑定 Flash (App 区) ---
  // 由 YmaC 从 flash_map 注入 App 起始地址 (如 STM32 0x08008000)
  BspFlashInfo app_flash = {
      .base_addr = g_boot_root.config.bootloader_cfg.app_addr,
      .size = g_boot_root.config.bootloader_cfg.app_max_size,
      .min_erase_size = 0u,  // 后端自动探测 (页大小)
      .min_write_size = 0u,
  };
  BspFlash *flash = bsp_flash_bind(NULL);
  if (flash == NULL) {
    for (;;) { /* Flash 绑定失败停机 */ }
  }
  if (bsp_flash_set_region(flash, &app_flash) != 0) {
    for (;;) { /* Flash 区域配置失败停机 */ }
  }

  // --- 2. 绑定升级传输 (UART 示例; CAN 类似) ---
  // UART: 需外部注入 BspUart 句柄 (bsp_uart_bind 结果)
  // UartConfig uart_cfg = { .port = ... };
  // uart_init(&s_up_uart, &uart_cfg);
  BootLoaderTransport transport = {
      .rx_push = up_rx_push,
      .tx_report = up_tx_report,
      .ctx = &s_up_uart,
  };

  // --- 3. 初始化 Bootloader 模块 ---
  // 注: 声明必须在锚点外 (replace_anchored_block 会整体替换锚点 span), 否则注入会删掉声明
  BootLoaderCfg bl_cfg = g_boot_root.config.bootloader_cfg;
  // YmaC 注入: 默认配置填充 (app_addr/app_max_size 来自 bsp_flash_map.h) + 升级传输选择
  /* YMAC BOOTLOADER_CFG BEGIN */
  /* YMAC BOOTLOADER_CFG END */

  // --- 3b. 补默认值 (若 YmaC 未注入) ---
  if (bl_cfg.rx_ring_size == 0u) bl_cfg.rx_ring_size = 256u;
  if (bl_cfg.db_upgrade_key == 0) bl_cfg.db_upgrade_key = "upgrade";
  if (bl_cfg.crc_type == 0) bl_cfg.crc_type = CrcPoly_32;

  int ret = boot_loader_init(&g_boot_root.bootloader, &transport, &bl_cfg,
                                flash,
                                g_boot_root.config.db_buf, sizeof(g_boot_root.config.db_buf),
                                g_boot_root.config.rx_ring_buf);
  if (ret != ERR_OK) {
    for (;;) { /* Bootloader 初始化失败停机 */ }
  }

  // --- 4. 判断: 无升级请求 → 校验 App 有效 → 跳转 ---
  if (!g_boot_root.bootloader.upgrade_requested &&
      bsp_jump_validate_app(bl_cfg.app_addr) == 0) {
    boot_loader_jump(&g_boot_root.bootloader);  // 跳转不返回
  }
  // 有升级请求 或 App 无效 → 停在 bootloader_background() 升级
}

// ======== Bootloader 主循环 ========

void bootloader_background(void) {
  // 升级协议主循环 (BackgroundTask 语义): 收包 → 写 Flash → 校验 → 跳转
  for (;;) {
    boot_loader_poll(&g_boot_root.bootloader);
    // 可加: 定期喂狗 / LED 指示 (可选)
  }
}
